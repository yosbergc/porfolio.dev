---
import '@fontsource-variable/onest'
import '../styles/global.css'

import { getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'

import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import { alternatePaths } from '@/i18n/utils'
import { defaultLang, ui, type Lang } from '@/i18n/ui'
import { SITE } from '@/data/site'

interface Props {
  locale: Lang
  title: string
  description: string
  path: string
  image?: ImageMetadata
  imageAlt?: string
  type?: 'website' | 'article'
  noindex?: boolean
  alternates?: Record<Lang, string>
}

const {
  locale,
  title,
  description,
  path,
  image,
  imageAlt = ui[locale]['site.ogAlt'],
  type = 'website',
  noindex = false,
  alternates = alternatePaths(),
} = Astro.props

const siteURL = Astro.site ?? new URL(SITE.url)
const canonical = new URL(path, siteURL).href
const ogLocale = locale === 'es' ? 'es_ES' : 'en_US'
const ogLocaleAlternate = locale === 'es' ? 'en_US' : 'es_ES'

const ogImage = image
  ? new URL(
      (
        await getImage({
          src: image,
          width: 1200,
          height: 630,
          fit: 'cover',
          position: 'center',
          format: 'jpg',
          quality: 82,
        })
      ).src,
      siteURL,
    ).href
  : new URL('/og.jpg', siteURL).href
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f4ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0d0c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(alternates.en, siteURL)} />
    <link rel="alternate" hreflang="es" href={new URL(alternates.es, siteURL)} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternates[defaultLang], siteURL)} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script is:inline>
      ;(() => {
        try {
          const stored = localStorage.getItem('theme')
          const explicit = stored === 'dark' ? true : stored === 'light' ? false : null
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
          document.documentElement.classList.toggle('dark', explicit ?? prefersDark)
        } catch {
          /* no-op */
        }
      })()
    </script>
  </head>

  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-bg"
    >
      {ui[locale]['nav.skip']}
    </a>
    <div class="flex min-h-screen flex-col">
      <Header locale={locale} />
      <main id="main-content" class="flex-1">
        <slot />
      </main>
      <Footer locale={locale} />
    </div>
  </body>
</html>
