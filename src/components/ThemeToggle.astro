---
import MoonIcon from './icons/Moon.astro'
import SunIcon from './icons/Sun.astro'
import { useTranslations } from '@/i18n/utils'
import type { Lang } from '@/i18n/ui'

interface Props {
  locale: Lang
}

const { locale } = Astro.props
const t = useTranslations(locale)
---

<button
  type="button"
  class="icon-btn"
  data-theme-toggle
  aria-label={t('theme.label')}
  aria-pressed="false"
  data-light-label={t('theme.dark')}
  data-dark-label={t('theme.light')}
  title={t('theme.label')}
>
  <MoonIcon class="theme-moon size-[18px]" />
  <SunIcon class="theme-sun hidden size-[18px]" />
</button>

<style>
  :global(html.dark) .theme-moon {
    display: none;
  }

  :global(html.dark) .theme-sun {
    display: block;
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')
  const media = window.matchMedia('(prefers-color-scheme: dark)')

  const syncThemeButton = () => {
    if (!button) return
    const isDark = document.documentElement.classList.contains('dark')
    button.setAttribute('aria-pressed', String(isDark))
    const label = isDark ? button.dataset.darkLabel : button.dataset.lightLabel
    if (label) {
      button.setAttribute('aria-label', label)
      button.title = label
    }
  }

  if (button) {
    syncThemeButton()
    button.addEventListener('click', () => {
      const nextIsDark = !document.documentElement.classList.contains('dark')
      document.documentElement.classList.toggle('dark', nextIsDark)
      try {
        localStorage.setItem('theme', nextIsDark ? 'dark' : 'light')
      } catch {
        /* no-op */
      }
      syncThemeButton()
    })
  }

  media.addEventListener('change', (event) => {
    try {
      if (localStorage.getItem('theme')) return
    } catch {
      /* no-op */
    }
    document.documentElement.classList.toggle('dark', event.matches)
    syncThemeButton()
  })
</script>
