---
import Layout from '@/layouts/Layout.astro'
import FreebieCard from './FreebieCard.astro'
import { freebieAlternates, freebiePath, homePath, useTranslations } from '@/i18n/utils'
import type { Lang } from '@/i18n/ui'
import { freebieThumbnailAlt, getFreebies } from '@/lib/freebies'
import { SITE } from '@/data/site'

interface Props {
  locale: Lang
}

const { locale } = Astro.props
const t = useTranslations(locale)
const projects = await getFreebies()
const socialEntry = projects.find(
  (entry) => entry.data.ogImage?.trim() || entry.data.thumbnail?.trim(),
)
const socialImage =
  socialEntry?.data.ogImage?.trim() || socialEntry?.data.thumbnail?.trim()
const socialImageAlt = socialEntry
  ? freebieThumbnailAlt(socialEntry, locale)
  : t('freebies.pageTitle')
---

<Layout
  locale={locale}
  title={t('freebies.pageTitle')}
  description={t('freebies.pageDescription')}
  path={freebiePath(locale)}
  alternates={freebieAlternates()}
  socialImage={socialImage}
  imageAlt={socialImageAlt}
  forceDark
>
  <section class="relative overflow-hidden">
    <div class="container-page pt-10 md:pt-16">
      <div class="flex flex-wrap items-center gap-3">
        <a href={homePath(locale)} class="link-arrow text-muted">
          <span aria-hidden="true">←</span>
          {t('freebies.backHome')}
        </a>
        <span class="chip chip-solid">{t('freebies.badge')}</span>
      </div>

      <div class="mt-8 grid gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <h1 class="display-sm max-w-[15ch] text-balance">{t('freebies.title')}</h1>
        </div>
        <div class="lg:col-span-5 lg:justify-self-end">
          <p class="max-w-md text-sm leading-relaxed text-muted">{t('freebies.description')}</p>
          <p class="mt-4 text-xs text-muted/80">{t('freebies.note')}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="container-page mt-10 md:mt-14">
    {
      projects.length > 0 ? (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((entry) => (
            <FreebieCard entry={entry} locale={locale} />
          ))}
        </div>
      ) : (
        <p class="card p-8 text-sm text-muted">{t('freebies.empty')}</p>
      )
    }
  </section>

  <section class="container-page mt-12 pb-4 md:mt-16">
    <div class="card flex flex-col gap-5 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
      <div>
        <p class="eyebrow">{t('freebies.followEyebrow')}</p>
        <p class="mt-3 max-w-md text-sm leading-relaxed text-muted">{t('freebies.followText')}</p>
        <p class="mt-3 text-xs text-muted/80">{t('freebies.license')}</p>
      </div>
      <a
        href={SITE.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary shrink-0"
      >
        {t('freebies.followCta')}
        <span class="sr-only">({t('work.openNewTab')})</span>
      </a>
    </div>
  </section>
</Layout>
