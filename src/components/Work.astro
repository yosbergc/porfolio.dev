---
import ProjectCard from './ProjectCard.astro'
import SectionHeading from './SectionHeading.astro'
import { projects } from '@/data/projects'
import { otherProjects } from '@/data/otherProjects'
import { useTranslations } from '@/i18n/utils'
import type { Lang } from '@/i18n/ui'

interface Props {
  locale: Lang
}

const { locale } = Astro.props
const t = useTranslations(locale)

const spans: Record<string, string> = {
  'futurasight-screens': 'col-span-12 lg:col-span-7',
  futurasight: 'col-span-12 lg:col-span-5',
  'right-at-home-realty-team': 'col-span-12 md:col-span-6 lg:col-span-7',
  'azteca-woodlawn': 'col-span-12 md:col-span-6 lg:col-span-5',
  'azteca-gastonia': 'col-span-12 md:col-span-6 lg:col-span-6',
  'azteca-smith-corners': 'col-span-12 md:col-span-6 lg:col-span-6',
}

const sizesBySlug: Record<string, string> = {
  'futurasight-screens': '(max-width: 1024px) 100vw, 760px',
  futurasight: '(max-width: 1024px) 100vw, 520px',
  'right-at-home-realty-team': '(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 760px',
  'azteca-woodlawn': '(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 520px',
  'azteca-gastonia': '(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 620px',
  'azteca-smith-corners': '(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 620px',
}
---

<section id="work" class="section-pad scroll-m-20 border-t border-ink/10">
  <div class="container-page">
    <SectionHeading eyebrow={t('work.eyebrow')} description={t('work.description')}>
      <h2 class="h2 max-w-[14ch] text-balance">{t('work.title')}</h2>
    </SectionHeading>

    <div class="bento mt-10 md:mt-14">
      {
        projects.map((project) => (
          <ProjectCard
            project={project}
            locale={locale}
            variant={project.slug === 'futurasight' ? 'overlay' : 'stacked'}
            class={spans[project.slug] ?? 'col-span-12'}
            sizes={sizesBySlug[project.slug]}
            loading="lazy"
          />
        ))
      }
    </div>

    <div class="mt-20 md:mt-28">
      <div class="flex flex-col gap-3 border-t border-ink/10 pt-8 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="eyebrow">{t('work.otherTitle')}</p>
          <p class="mt-3 max-w-lg text-sm leading-relaxed text-muted">{t('work.otherDescription')}</p>
        </div>
      </div>

      <div class="mt-8 grid gap-3 md:grid-cols-2">
        {
          otherProjects.map((project) => (
            <article class="card card-lift flex gap-4 p-4 sm:p-5">
              <div class="relative hidden w-28 shrink-0 self-stretch overflow-hidden rounded-2xl bg-surface-2 sm:block">
                <img
                  src={project.image}
                  alt=""
                  width={project.width}
                  height={project.height}
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover object-top"
                />
              </div>
              <div class="flex min-w-0 flex-1 flex-col">
                <div class="flex items-start justify-between gap-3">
                  <h3 class="text-[0.98rem] font-semibold tracking-[-0.02em]">
                    <a href={project.url} target="_blank" rel="noopener noreferrer" class="text-ink no-underline hover:underline">
                      {project.title}
                      <span class="sr-only">({t('work.openNewTab')})</span>
                    </a>
                  </h3>
                  <a href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`${project.title} — ${t('work.live')} (${t('work.openNewTab')})`} class="text-muted transition-colors hover:text-ink">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M7 17 17 7" />
                      <path d="M7 7h10v10" />
                    </svg>
                  </a>
                </div>
                <p class="mt-1.5 text-[0.8rem] leading-relaxed text-muted">{project.description[locale]}</p>
                <div class="mt-3 flex flex-wrap items-center gap-1.5">
                  {project.tags.map((tag) => <span class="chip">{tag}</span>)}
                  {project.code && (
                    <a href={project.code} target="_blank" rel="noopener noreferrer" class="chip transition-colors hover:text-ink">
                      {t('work.code')}
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
