---
import { Image } from 'astro:assets'
import ArrowDown from './icons/ArrowDown.astro'
import ArrowRight from './icons/ArrowRight.astro'
import ArrowUpRight from './icons/ArrowUpRight.astro'
import { projects } from '@/data/projects'
import { casePath, designPath, useTranslations, sectionHref } from '@/i18n/utils'
import type { Lang } from '@/i18n/ui'

interface Props {
  locale: Lang
}

const { locale } = Astro.props
const t = useTranslations(locale)

const stack = ['Astro', 'Next.js', 'React', 'TypeScript', 'Tailwind CSS']
const featured = projects.find((project) => project.featured) ?? projects[0]
---

<section class="container-page pb-16 pt-10 md:pb-20 md:pt-16">
  <div class="bento">
    <article class="card col-span-12 flex min-h-[460px] flex-col justify-between p-6 sm:p-9 lg:col-span-7 lg:p-12">
      <div>
        <p class="text-[0.7rem] font-medium text-muted">{t('hero.location')}</p>

        <h1 class="display mt-6 max-w-[18ch] text-balance sm:mt-8">{t('hero.title')}</h1>

        <p class="mt-6 max-w-[46ch] text-[0.98rem] leading-relaxed text-muted sm:text-base">
          {t('hero.description')}
        </p>
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a href={sectionHref(locale, 'work')} class="btn btn-primary">
          {t('hero.ctaWork')}
          <ArrowDown class="size-4" />
        </a>
        <a href={sectionHref(locale, 'contact')} class="btn btn-secondary">
          {t('hero.ctaContact')}
          <ArrowUpRight class="size-4" />
        </a>
        <a href={designPath(locale)} class="link-arrow ml-1">
          {t('hero.ctaDesign')}
          <ArrowRight class="size-3.5" />
        </a>
      </div>
    </article>

    <article class="card project-card group relative col-span-12 min-h-[420px] overflow-hidden sm:col-span-6 lg:col-span-5 lg:min-h-[560px]">
      <Image
        src={featured.image}
        alt={featured.imageAlt[locale]}
        widths={[480, 700, 840]}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 480px"
        format="webp"
        quality={82}
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.025]"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0 p-5 sm:p-6">
        <span class="chip chip-inverted">{featured.category[locale]}</span>
        <p class="mt-3 max-w-[24ch] text-[1.15rem] font-semibold leading-snug tracking-[-0.02em] text-white">
          <a
            href={casePath(locale, featured.slug)}
            class="text-white no-underline decoration-white/30 underline-offset-4 hover:underline"
          >
            {featured.title}
          </a>
        </p>
        <p class="mt-1.5 max-w-[32ch] text-xs leading-snug text-white/75">{featured.tagline[locale]}</p>
        <a href={casePath(locale, featured.slug)} class="link-arrow mt-3 text-white hover:text-white">
          {t('work.caseStudy')}
          <ArrowRight class="size-4" />
        </a>
      </div>
    </article>

    <article class="card col-span-12 flex flex-col justify-center p-5 sm:p-6">
      <p class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-muted">{t('hero.stackLabel')}</p>
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {
          stack.map((item) => (
            <li class="chip chip-solid">{item}</li>
          ))
        }
      </ul>
    </article>
  </div>
</section>
