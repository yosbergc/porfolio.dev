---
import GitHubIcon from './icons/GitHub.astro'
import LinkedInIcon from './icons/LinkedIn.astro'
import MailIcon from './icons/Mail.astro'
import { useTranslations, homePath, sectionHref } from '@/i18n/utils'
import type { Lang } from '@/i18n/ui'
import { SITE } from '@/data/site'

interface Props {
  locale: Lang
}

const { locale } = Astro.props
const t = useTranslations(locale)
const home = homePath(locale)
const year = new Date().getFullYear()

const nav = [
  { label: t('nav.experience'), href: sectionHref(locale, 'experience') },
  { label: t('nav.work'), href: sectionHref(locale, 'work') },
  { label: t('nav.approach'), href: sectionHref(locale, 'approach') },
  { label: t('nav.about'), href: sectionHref(locale, 'about') },
  { label: t('nav.contact'), href: sectionHref(locale, 'contact') },
]
---

<footer class="border-t border-ink/10">
  <div class="container-page py-12 md:py-16">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-5">
        <a href={home} class="flex items-center gap-2.5 no-underline" aria-label={`${SITE.name} — ${t('nav.home')}`}>
          <span class="brand-mark" aria-hidden="true">YG</span>
          <span class="text-sm font-semibold tracking-[-0.02em]">{SITE.name}</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">
          {t('footer.tagline')}
        </p>
      </div>

      <div class="md:col-span-3">
        <h2 class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-muted">{t('footer.nav')}</h2>
        <ul class="mt-4 space-y-2.5">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="text-sm text-muted no-underline transition-colors hover:text-ink">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="md:col-span-4">
        <h2 class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-muted">{t('footer.connect')}</h2>
        <ul class="mt-4 space-y-2.5">
          <li>
            <a href={`mailto:${SITE.email}`} class="inline-flex items-center gap-2 text-sm text-muted no-underline transition-colors hover:text-ink">
              <MailIcon class="size-4" />
              {SITE.email}
            </a>
          </li>
          <li>
            <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm text-muted no-underline transition-colors hover:text-ink">
              <LinkedInIcon class="size-4" />
              LinkedIn
              <span class="sr-only">({t('work.openNewTab')})</span>
            </a>
          </li>
          <li>
            <a href={SITE.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm text-muted no-underline transition-colors hover:text-ink">
              <GitHubIcon class="size-4" />
              GitHub
              <span class="sr-only">({t('work.openNewTab')})</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-ink/10 pt-6 text-xs text-muted md:flex-row md:items-center md:justify-between">
      <p>© {year} {SITE.name}. {t('footer.rights')}</p>
      <p class="max-w-xl md:text-right">
        {t('footer.credit')}
        <a href="https://creativecommons.org/licenses/by-nc/4.0/" target="_blank" rel="noopener noreferrer" class="ml-1 underline decoration-ink/20 underline-offset-2 hover:text-ink">CC BY-NC 4.0</a>
      </p>
    </div>

    <div class="mt-6 flex justify-end">
      <a href="#main-content" class="link-arrow" aria-label={t('footer.backTop')}>
        {t('footer.backTop')}
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 19V5" />
          <path d="m5 12 7-7 7 7" />
        </svg>
      </a>
    </div>
  </div>
</footer>
