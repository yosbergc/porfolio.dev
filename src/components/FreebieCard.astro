---
import ArrowDown from './icons/ArrowDown.astro'
import ArrowRight from './icons/ArrowRight.astro'
import PlayIcon from './icons/Play.astro'
import { freebiePath, useTranslations } from '@/i18n/utils'
import type { Lang } from '@/i18n/ui'
import {
  formatFreebieDate,
  hasFreebieDownload,
  freebieThumbnailAlt,
  type FreebieEntry,
} from '@/lib/freebies'

interface Props {
  entry: FreebieEntry
  locale: Lang
  class?: string
  loading?: 'eager' | 'lazy'
}

const { entry, locale, class: className = '', loading = 'lazy' } = Astro.props
const t = useTranslations(locale)

const href = freebiePath(locale, entry.id)
const title = entry.data.title[locale]
const description = entry.data.description[locale]
const thumbnail = entry.data.thumbnail?.trim()
const thumbnailFallback = entry.data.thumbnailFallback?.trim()
const usePicture = Boolean(
  thumbnail?.toLowerCase().endsWith('.avif') && thumbnailFallback,
)
const downloadUrl = entry.data.downloadUrl?.trim()
const canDownload = hasFreebieDownload(entry)
const alt = freebieThumbnailAlt(entry, locale)
const date = formatFreebieDate(entry.data.date, locale)
---

<article class:list={['card card-lift group flex h-full flex-col overflow-hidden', className]}>
  <a
    href={href}
    class="relative block aspect-video overflow-hidden bg-surface-2"
    aria-label={`${title} — ${t('freebies.viewProject')}`}
  >
    {
      thumbnail ? (
        usePicture ? (
          <picture class="block h-full w-full">
            <source srcset={thumbnail} type="image/avif" />
            <img
              src={thumbnailFallback}
              alt={alt}
              loading={loading}
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
            />
          </picture>
        ) : (
          <img
            src={thumbnail}
            alt={alt}
            loading={loading}
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
          />
        )
      ) : (
        <div class="freebie-placeholder flex h-full w-full flex-col items-center justify-center gap-3 p-6 text-center">
          <span class="flex size-11 items-center justify-center rounded-full border border-white/15 bg-white/5 text-white/80 backdrop-blur-md">
            <PlayIcon class="ml-0.5 size-4" />
          </span>
          <span class="text-[0.62rem] font-semibold uppercase tracking-[0.2em] text-white/45">
            {t('freebies.media')}
          </span>
        </div>
      )
    }
    {
      entry.data.featured && (
        <span class="absolute left-3 top-3 rounded-full border border-white/20 bg-black/55 px-2.5 py-1 text-[0.6rem] font-semibold text-white backdrop-blur-md">
          {t('freebies.featured')}
        </span>
      )
    }
  </a>

  <div class="flex flex-1 flex-col p-4 sm:p-5">
    <div class="flex flex-wrap items-center gap-1.5">
      {entry.data.format && <span class="chip">{entry.data.format}</span>}
      {entry.data.duration && <span class="chip">{entry.data.duration}</span>}
      <span class="chip">{date}</span>
    </div>

    <h3 class="mt-3 text-[1.02rem] font-semibold leading-snug tracking-[-0.025em]">
      <a
        href={href}
        class="text-ink no-underline decoration-ink/20 underline-offset-4 group-hover:underline"
      >
        {title}
      </a>
    </h3>

    <p class="mt-2 text-[0.82rem] leading-relaxed text-muted">{description}</p>

    <div class="mt-auto flex flex-col gap-2 pt-5 sm:flex-row sm:items-center">
      {
        canDownload ? (
          <a
            href={downloadUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary w-full sm:w-auto"
            aria-label={`${t('freebies.download')} ${title}`}
          >
            <ArrowDown class="size-4" />
            {t('freebies.download')}
            <span class="sr-only">({t('work.openNewTab')})</span>
          </a>
        ) : (
          <span
            class="btn btn-secondary w-full cursor-default opacity-60 sm:w-auto"
            aria-disabled="true"
          >
            <ArrowDown class="size-4" />
            {t('freebies.comingSoon')}
          </span>
        )
      }
      <a href={href} class="link-arrow justify-center sm:ml-auto">
        {t('freebies.viewProject')}
        <ArrowRight class="size-3.5" />
      </a>
    </div>
  </div>
</article>

<style>
  .freebie-placeholder {
    background:
      radial-gradient(circle at 30% 20%, rgb(var(--accent) / 0.2), transparent 58%),
      linear-gradient(145deg, rgb(var(--surface-2)), rgb(var(--bg)));
  }
</style>
